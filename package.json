{
  "name": "ridezones",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
"scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"php -S localhost:8000 -t apps/backend/public\"",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build:frontend": "cd apps/frontend && npm run build",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^12.0.5",
    "vue": "^3.5.22"
  }
}
